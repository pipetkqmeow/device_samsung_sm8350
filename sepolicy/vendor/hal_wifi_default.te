# hal_wifi_default.te

# Needed for wifi hotspot to read sap interface
get_prop(hal_wifi_default, vendor_wifi_prop)

allow hal_wifi_default self:capability sys_module;

# /sys/module/dhd/parameters/* (firmware/nvram paths)
allow hal_wifi_default sysfs_ss_writable:dir search;
allow hal_wifi_default sysfs_ss_writable:file rw_file_perms;

# /sys/wifi/*
allow hal_wifi_default sysfs_wifi:dir r_dir_perms;
allow hal_wifi_default sysfs_wifi:file rw_file_perms;
